generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ============================================================
// USER & AUTH
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String?
  lastName      String?
  role          String    @default("user")
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  wishlist      Wishlist[]
  reviews       Review[]
  cart          Cart?
  
  interests     UserInterest[]
  behaviors     UserBehavior[]
  productViews  ProductView[]
  searchHistory SearchHistory[]
  sessions      UserSession[]
  recommendations RecommendationCache[]
  migrationLogs MigrationLog[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  street    String
  city      String
  state     String?
  zipCode   String
  country   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([token])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([token])
}

// ============================================================
// PRODUCTS & CATEGORIES
// ============================================================

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String?   @db.Text
  price            Float
  comparePrice     Float?
  gender           String
  category         String?
  subcategory      String?
  categoryGroup    String?
  brandId          String?
  brand            Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandName        String?
  images           String    @default("[]")
  stockQuantity    Int       @default(0)
  sku              String?
  isNew            Boolean   @default(false)
  isSale           Boolean   @default(false)
  isTrending       Boolean   @default(false)
  isBestseller     Boolean   @default(false)
  isSizeInclusive  Boolean   @default(false)
  isMaternity      Boolean   @default(false)
  isAdaptive       Boolean   @default(false)
  tags             String    @default("[]")
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  variants         Variant[]
  reviews          Review[]
  orderItems       OrderItem[]
  wishlistItems    Wishlist[]
  flashSales       FlashSale[]
  
  behaviors        UserBehavior[]
  productViews     ProductView[]
  analytics        ProductAnalytics[]
}

model Variant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  color     String?
  sku       String?
  stock     Int      @default(0)
  price     Float?
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String?
  description String?
  website     String?
  featured    Boolean   @default(false)
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Category {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  gender          String
  description     String?
  image           String?
  isActive        Boolean   @default(true)
  displayOrder    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  categoryGroups  CategoryGroup[]
  analytics       CategoryAnalytics[]
}

model CategoryGroup {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  icon         String?
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  subCategories SubCategory[]
}

model SubCategory {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  categoryGroupId  String
  categoryGroup    CategoryGroup @relation(fields: [categoryGroupId], references: [id], onDelete: Cascade)
  categoryId       String
  isActive         Boolean   @default(true)
  displayOrder     Int       @default(0)
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  orderNumber      String    @unique
  status           String    @default("pending")
  total            Float
  subtotal         Float
  tax              Float
  shippingCost     Float     @default(0)
  discount         Float     @default(0)
  couponCode       String?
  shippingAddress  String
  billingAddress   String?
  paymentMethod    String?
  paymentStatus    String    @default("pending")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items            OrderItem[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  name       String
  price      Float
  quantity   Int
  size       String?
  color      String?
  image      String?
}

// ============================================================
// CART & WISHLIST
// ============================================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     String   @default("[]")
  updatedAt DateTime @updatedAt
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  comment   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

// ============================================================
// PROMOTIONS
// ============================================================

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  type          String
  value         Float
  minOrderAmount Float?
  maxDiscount   Float?
  usageLimit    Int       @default(100)
  perUserLimit  Int       @default(1)
  usedCount     Int       @default(0)
  startDate     DateTime
  endDate       DateTime
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FlashSale {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  salePrice         Float
  discount          Int
  stock             Int
  soldCount         Int      @default(0)
  limitPerCustomer  Int      @default(2)
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================================
// EMAIL
// ============================================================

model Email {
  id          String   @id @default(cuid())
  template    String
  to          String
  subject     String
  html        String?  @db.Text
  status      String   @default("pending")
  error       String?
  metadata    String?  @db.Text
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderId     String?
  userId      String?
}

// ============================================================
// CONTACT - NEW
// ============================================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  status    String   @default("unread") // unread, read, replied
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// CONFIGURATION
// ============================================================

model MerchandisingConfig {
  id        String   @id @default("single")
  data      String   @db.Text
  updatedAt DateTime @updatedAt
}

model SEOConfig {
  id        String   @id @default("single")
  data      String   @db.Text
  updatedAt DateTime @updatedAt
}

// ============================================================
// RECOMMENDATIONS & ANALYTICS
// ============================================================

model UserInterest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  weight    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
  @@index([category])
}

model UserBehavior {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  action    String
  category  String?
  subcategory String?
  gender    String?
  price     Float?
  timestamp DateTime @default(now())
  sessionId String?
  referrer  String?
  device    String?
  ipAddress String?

  @@index([userId])
  @@index([productId])
  @@index([action])
  @@index([timestamp])
  @@index([category])
}

model ProductView {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())
  sessionId String?
  referrer  String?
  timeSpent Int?
  scrollDepth Int?

  @@index([userId])
  @@index([productId])
  @@index([viewedAt])
  @@index([sessionId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  category  String?
  gender    String?
  results   Int?
  clicked   String?
  timestamp DateTime @default(now())
  sessionId String?

  @@index([userId])
  @@index([query])
  @@index([timestamp])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String   @unique
  startTime DateTime @default(now())
  endTime   DateTime?
  duration  Int?
  device    String?
  browser   String?
  os        String?
  ipAddress String?
  location  String?
  isActive  Boolean  @default(true)

  @@index([userId])
  @@index([sessionId])
}

model RecommendationCache {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  String   @db.Text
  type      String
  generatedAt DateTime @default(now())
  expiresAt DateTime
  usedCount Int      @default(0)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

model ProductAnalytics {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  views     Int      @default(0)
  clicks    Int      @default(0)
  addToCart Int      @default(0)
  purchases Int      @default(0)
  wishlist  Int      @default(0)
  date      DateTime @default(now())
  revenue   Float    @default(0)

  @@unique([productId, date])
  @@index([productId])
  @@index([date])
}

model CategoryAnalytics {
  id        String   @id @default(cuid())
  categoryId String?
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName String
  gender    String?
  views     Int      @default(0)
  clicks    Int      @default(0)
  purchases Int      @default(0)
  revenue   Float    @default(0)
  date      DateTime @default(now())

  @@unique([categoryName, gender, date])
  @@index([categoryName])
  @@index([date])
  @@index([categoryId])
}

model MigrationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  status    String
  records   Int      @default(0)
  error     String?  @db.Text
  metadata  String?  @db.Text
  startedAt DateTime @default(now())
  completedAt DateTime?
  version   String   @default("1.0")

  @@index([userId])
  @@index([status])
  @@index([startedAt])
}